# Copy to .env (git-ignored) and fill in.
# Nothing here has a value baked into the repo: every address, credential and
# external checkout is configuration, not source.

# --- Gemini -----------------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override (default: gemini-robotics-er-2-preview)
PHYSICALAGENT_ER_MODEL=

# --- HiWonder ROSPug (quadruped) --------------------------------------------
# Hostname or IP. Defaults to the mDNS name the robot advertises (rospug.local).
ROSPUG_HOST=
ROSPUG_ROSBRIDGE_PORT=9090
ROSPUG_VIDEO_PORT=8080
# Vendor factory SSH credentials are documented by HiWonder; they are NOT
# shipped as defaults here. Fill in what your robot actually uses.
ROSPUG_SSH_USER=
ROSPUG_SSH_PASS=

# --- HiWonder TonyPi (humanoid) ---------------------------------------------
# 192.168.149.1 is HiWonder's own AP-mode default and is the built-in fallback.
TONYPI_HOST=
TONYPI_RPC_PORT=9030
TONYPI_VIDEO_PORT=8080
# Vendor factory defaults again — supply your own, do not assume.
TONYPI_SSH_USER=
TONYPI_SSH_PASS=

# --- MiniHexa (hexapod) -----------------------------------------------------
# REQUIRED for the BLE path; a MAC is hardware-specific so there is no default.
# Find it with `bluetoothctl scan on` — the device advertises "miniHexa".
MINIHEXA_BLE_ADDRESS=
MINIHEXA_DEVICE=/dev/ttyUSB0

# --- External projects (optional; only the features that use them degrade) ---
# NVIDIA GR00T-WholeBodyControl (the SONIC whole-body controller)
WBC_ROOT=
WBC_PY=
# Unitree unitree_sim_isaaclab checkout, for the Isaac bridge + third_party patches
UNITREE_SIM_ROOT=
# Isaac-side interpreter and its source-built CycloneDDS install prefix
ISAAC_PY=
ISAAC_CYCLONEDDS_HOME=
# Output tree of a photo-to-MuJoCo scene reconstruction tool -- a separate,
# unpublished project of the same author; for the furnished-lounge scene only
SCENE_SOURCE_ROOT=
# Where this repo writes evidence (default: ./artifacts)
PA_ARTIFACTS=
