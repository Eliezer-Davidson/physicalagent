new file mode 100644
index 0000000..890af4b
--- /dev/null
+++ b/gear_sonic_deploy/reference/build_sonic_g1_inspire.py
@@ -0,0 +1,153 @@
+#!/usr/bin/env python3
+"""
+Build a SONIC-compatible G1 + Inspire MJCF for run_sim_loop.py.
+
+Strategy (validated safe by base_sim.py + unitree_sdk2py_bridge.py):
+  - SONIC identifies the 29 BODY motors by joint @class (leg/ankle/arm/wrist/
+    torso_motor) and drives NUM_MOTORS(=29). Hands are driven only if
+    NUM_HAND_MOTORS>0. So: keep the 29 body joints/classes/actuators UNTOUCHED,
+    STRIP the Dex3 finger subtrees + their actuators, ATTACH Inspire hands as
+    PASSIVE joints (no @class SONIC recognizes, no actuator). Set
+    NUM_HAND_MOTORS: 0 in the wbc config -> SONIC ignores the Inspire joints
+    entirely. Body-joint mapping is name-derived, so unaffected.
+
+Reuses asymmetric wrist-attach transforms validated in a separate project (L/R Inspire
+URDFs are NOT clean mirrors).
+"""
+import os, sys, shutil, argparse
+import mujoco
+
+SONIC_MODEL = os.environ["WBC_ROOT"] + "/gear_sonic/data/robot_model/model_data/g1/g1_29dof_with_hand.xml"
+INSPIRE_DIR = os.environ["INSPIRE_HAND_ASSETS"]   # xr_teleoperate assets/inspire_hand
+LEFT_URDF  = os.path.join(INSPIRE_DIR, "inspire_hand_left.urdf")
+RIGHT_URDF = os.path.join(INSPIRE_DIR, "inspire_hand_right.urdf")
+
+# Attach poses validated against a separate motion-retargeting project.      
+LEFT_POS  = (0.04,  0.003, 0.0); LEFT_QUAT  = (0.7071068, 0.0, 0.0, 0.7071068)     # +90 Z
+RIGHT_POS = (0.04, -0.003, 0.0); RIGHT_QUAT = (0.0, 0.7071068, -0.7071068, 0.0)    # -90 Z . 180 X
+
+
+def load_inspire_spec(urdf_path):
+    cwd = os.getcwd()
+    try:
+        os.chdir(os.path.dirname(urdf_path))
+        spec = mujoco.MjSpec.from_file(os.path.basename(urdf_path))
+    finally:
+        os.chdir(cwd)
+    mesh_root = os.path.join(os.path.dirname(urdf_path), "meshes")
+    for m in spec.meshes:
+        fname = m.file
+        for pre in ("./meshes/", "meshes/"):
+            if fname.startswith(pre):
+                fname = fname[len(pre):]
+        ab = os.path.abspath(os.path.join(mesh_root, fname))
+        if not os.path.exists(ab):
+            raise FileNotFoundError(f"Inspire mesh missing: {ab}")
+        m.file = ab
+    spec.meshdir = ""
+    return spec
+
+
+def strip_dex3(spec):
+    removed_bodies, removed_acts = [], []
+    # delete Dex3 finger-chain root bodies (their subtrees go with them)
+    for side in ("left", "right"):
+        for finger in ("thumb", "middle", "index"):
+            bname = f"{side}_hand_{finger}_0_link"
+            b = spec.body(bname)
+            if b is not None:
+                removed_bodies.append(bname)
+                spec.delete(b)
+    # delete actuators whose target joint no longer exists (Dex3 finger motors)
+    live_joint_names = {j.name for j in spec.joints}
+    for a in list(spec.actuators):
+        tgt = a.target  # joint name the motor drives
+        if tgt and tgt not in live_joint_names:
+            removed_acts.append(a.name or tgt)
+            spec.delete(a)
+    return removed_bodies, removed_acts
+
+
+def rigidify_inspire(spec):
+    """Delete every Inspire finger JOINT (names 'L_*' / 'R_*') so the finger
+    links weld rigidly to the wrist. This is the ROOT-CAUSE fix for SONIC's
+    'index N out of bounds for size 29' crash: SONIC's sim loop indexes the
+    torque/ctrl array by (model_joint_index - 1) and sizes it to the actuator
+    count, which only holds when EVERY post-root joint is an actuated motor in
+    order. The 24 passive Inspire joints, injected mid-tree at the wrists, shove
+    the right-arm body joints past index 29 and overflow the array. With the
+    finger joints removed, njnt returns to 1 free + 29 body, nu stays 29, and
+    the identity map holds -- SONIC's body control is bit-identical to bare G1,
+    the robot just visibly wears (static) Inspire hands. Body joints are
+    'left_*'/'right_*'/'waist_*', so an 'L_'/'R_' prefix match is exact and
+    never touches a body joint."""
+    removed = []
+    for j in list(spec.joints):
+        if j.name.startswith("L_") or j.name.startswith("R_"):
+            removed.append(j.name)
+            spec.delete(j)
+    return removed
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--out", default=os.environ["WBC_ROOT"] + "/gear_sonic/data/robot_model/model_data/g1/g1_29dof_with_inspire.xml")
+    ap.add_argument("--rigid", action="store_true",
+                    help="Delete Inspire finger joints -> rigid hands (SONIC-safe, 29 body joints only)")
+    args = ap.parse_args()
+
+    # Load SONIC body+Dex3 from its own dir so body meshes resolve.
+    cwd = os.getcwd()
+    try:
+        os.chdir(os.path.dirname(SONIC_MODEL))
+        spec = mujoco.MjSpec.from_file(os.path.basename(SONIC_MODEL))
+    finally:
+        os.chdir(cwd)
+    print(f"[load] {SONIC_MODEL}")
+
+    rb, ra = strip_dex3(spec)
+    print(f"[strip] Dex3 bodies removed: {rb}")
+    print(f"[strip] Dex3 actuators removed ({len(ra)}): {ra}")
+
+    for side, urdf, pos, quat in [("left", LEFT_URDF, LEFT_POS, LEFT_QUAT),
+                                  ("right", RIGHT_URDF, RIGHT_POS, RIGHT_QUAT)]:
+        parent = spec.body(f"{side}_wrist_yaw_link")
+        if parent is None:
+            raise RuntimeError(f"{side}_wrist_yaw_link not found")
+        site = parent.add_site(name=f"{side}_inspire_mount", pos=list(pos), quat=list(quat))
+        hand = load_inspire_spec(urdf)
+        spec.attach(hand, prefix="", site=site)
+        print(f"[attach] Inspire {side} hand at {side}_wrist_yaw_link")
+
+    if args.rigid:
+        rj = rigidify_inspire(spec)
+        print(f"[rigid] deleted {len(rj)} Inspire finger joints -> hands welded rigid to wrists")
+
+    os.chdir(os.path.dirname(SONIC_MODEL))   # body meshes are relative ('meshes/*'); Inspire are absolute
+    model = spec.compile()
+    # report joint inventory
+    njnt = model.njnt
+    body_classes = ("leg_motor","ankle_motor","arm_motor","wrist_motor","torso_motor")
+    print(f"[compile] OK  nq={model.nq} nv={model.nv} njnt={njnt} nu={model.nu} (actuators)")
+    # confirm the 29 body joints still present by name
+    from_29 = ["left_hip_pitch_joint","left_hip_roll_joint","left_hip_yaw_joint","left_knee_joint",
+        "left_ankle_pitch_joint","left_ankle_roll_joint","right_hip_pitch_joint","right_hip_roll_joint",
+        "right_hip_yaw_joint","right_knee_joint","right_ankle_pitch_joint","right_ankle_roll_joint",
+        "waist_yaw_joint","waist_roll_joint","waist_pitch_joint","left_shoulder_pitch_joint",
+        "left_shoulder_roll_joint","left_shoulder_yaw_joint","left_elbow_joint","left_wrist_roll_joint",
+        "left_wrist_pitch_joint","left_wrist_yaw_joint","right_shoulder_pitch_joint","right_shoulder_roll_joint",
+        "right_shoulder_yaw_joint","right_elbow_joint","right_wrist_roll_joint","right_wrist_pitch_joint",
+        "right_wrist_yaw_joint"]
+    missing = [j for j in from_29 if mujoco.mj_name2id(model, mujoco.mjtObj.mjOBJ_JOINT, j) == -1]
+    if missing:
+        raise SystemExit(f"[ABORT] body joints lost in build: {missing}")
+    print(f"[verify] all 29 body joints present. actuators nu={model.nu} (expect 29 body motors)")
+
+    spec.compile()
+    xml = spec.to_xml()
+    with open(args.out, "w") as f:
+        f.write(xml)
+    print(f"[write] {args.out}")
+
+if __name__ == "__main__":
+    main()
