@@ -0,0 +1,216 @@
+#!/usr/bin/env python3
+"""
+Hand-primitive library demo for the G1 + Inspire hands (pure kinematics; no SONIC).
+
+Subcommands
+-----------
+  render   -> labeled montage PNG of every primitive (self-check / proof)
+  vary     -> montage of size x strength variations for one primitive (robustness proof)
+  live     -> open a MuJoCo viewer; the standing G1 cycles both hands through the whole
+              library, interpolating pose-to-pose, with the current primitive named in the
+              terminal. This is the "perform the primitives before my eyes" view.
+
+A primitive is a 6-DOF closure vector [pinky,ring,middle,index,thumb_bend,thumb_yaw] in [0,1];
+map6to12() expands it to the 12 model finger joints per hand using meta.joint_map. Size scales
+the grasp aperture; strength adds grip (force metadata + a little extra curl).
+"""
+import os, sys, json, argparse, time
+import numpy as np
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+GEAR_ROOT = os.environ["WBC_ROOT"]           # GR00T-WholeBodyControl root
+LIB = os.path.join(HERE, "hand_primitives.json")
+
+# ---- G1 upper-body "presentation" pose: bring both hands up in front, palms to camera ----
+BASE_QPOS = [0.0, 0.0, 0.80, 1.0, 0.0, 0.0, 0.0]   # free base: x y z (m) + quat wxyz, standing
+# Arms raised forward + elbows bent so both hands come up in front of the chest, palms to camera.
+PRESENT_POSE = {
+    "left_shoulder_pitch_joint": -1.30, "left_shoulder_roll_joint":  0.22, "left_shoulder_yaw_joint": 0.15,
+    "left_elbow_joint": 1.65, "left_wrist_roll_joint": 0.0, "left_wrist_pitch_joint": -0.30, "left_wrist_yaw_joint": 0.0,
+    "right_shoulder_pitch_joint": -1.30, "right_shoulder_roll_joint": -0.22, "right_shoulder_yaw_joint": -0.15,
+    "right_elbow_joint": 1.65, "right_wrist_roll_joint": 0.0, "right_wrist_pitch_joint": -0.30, "right_wrist_yaw_joint": 0.0,
+    # slight knee/hip bend so it reads as a natural stand, not a mannequin
+    "left_knee_joint": 0.15, "right_knee_joint": 0.15,
+    "left_hip_pitch_joint": -0.08, "right_hip_pitch_joint": -0.08,
+    "left_ankle_pitch_joint": -0.07, "right_ankle_pitch_joint": -0.07,
+}
+
+
+def load_lib():
+    with open(LIB) as f:
+        return json.load(f)
+
+
+def resolve_vec(lib, name, size="medium", strength="firm"):
+    """(name,size,strength) -> concrete 6-DOF closure vector in [0,1]."""
+    p = lib["primitives"][name]
+    vec = list(map(float, p["vec"]))            # [pinky,ring,middle,index,thumb_bend,thumb_yaw]
+    if p["sizeable"]:
+        s = lib["sizes"][size]
+        for i in range(5):                       # scale 4 fingers + thumb_bend; keep thumb_yaw (opposition)
+            vec[i] *= s
+    over = lib["strengths"][strength]["overclose"]
+    for i in range(5):
+        if vec[i] > 1e-6:                        # only tighten fingers already engaged
+            vec[i] = min(1.0, vec[i] + over)
+    return vec
+
+
+def map6to12(lib, vec):
+    """6-DOF closure -> {generic_joint_suffix: angle}. Suffix has no L_/R_ prefix yet."""
+    jm = lib["meta"]["joint_map"]
+    pinky, ring, middle, index, tbend, tyaw = vec
+    out = {}
+    for finger, c in (("pinky", pinky), ("ring", ring), ("middle", middle), ("index", index)):
+        prox_name, prox_hi = jm[finger]["proximal"]
+        inter_name, inter_hi = jm[finger]["intermediate"]
+        out[prox_name] = c * prox_hi
+        out[inter_name] = c * inter_hi
+    # thumb bend chain
+    pitch_name, pitch_hi = jm["thumb_bend"]["pitch"]
+    tinter_name, tinter_hi = jm["thumb_bend"]["intermediate"]
+    dist_name, dist_hi = jm["thumb_bend"]["distal"]
+    out[pitch_name] = tbend * pitch_hi
+    out[tinter_name] = tbend * tinter_hi
+    out[dist_name] = tbend * dist_hi
+    # thumb yaw (opposition) lerps over [lo,hi]
+    yaw_name, yaw_lo, yaw_hi = jm["thumb_yaw"]["yaw"]
+    out[yaw_name] = yaw_lo + tyaw * (yaw_hi - yaw_lo)
+    return out
+
+
+def build_model(lib):
+    import mujoco
+    xml = os.path.join(GEAR_ROOT, lib["meta"]["model"])
+    spec = mujoco.MjSpec.from_file(xml)
+    # add a floor + light for a legible render
+    g = spec.worldbody.add_geom(); g.name = "vfloor"; g.type = mujoco.mjtGeom.mjGEOM_PLANE
+    g.size = [0, 0, 0.05]; g.rgba = [0.55, 0.57, 0.60, 1.0]
+    l = spec.worldbody.add_light(); l.pos = [0.4, 0.4, 2.2]; l.dir = [-0.2, -0.2, -1]
+    spec.visual.global_.offwidth = 900; spec.visual.global_.offheight = 900
+    model = spec.compile()
+    return model
+
+
+def qadr(model, name):
+    return int(model.joint(name).qposadr[0])
+
+
+def apply_pose(model, data, finger_targets_by_side):
+    """Set base + presentation body pose + finger joints (dict suffix->angle per side)."""
+    import mujoco
+    mujoco.mj_resetData(model, data)
+    fb = qadr(model, "floating_base_joint")
+    data.qpos[fb:fb + 7] = BASE_QPOS
+    for jname, val in PRESENT_POSE.items():
+        data.qpos[qadr(model, jname)] = val
+    for side, targets in finger_targets_by_side.items():       # side in {"L_","R_"}
+        for suffix, ang in targets.items():
+            data.qpos[qadr(model, side + suffix)] = ang
+    mujoco.mj_forward(model, data)
+
+
+def both_hands(lib, vec):
+    m = map6to12(lib, vec)
+    return {"L_": m, "R_": m}
+
+
+# ------------------------------------------------------------------ render / vary
+def _render_grid(cells, out, title, cols=4, cam=None):
+    import mujoco
+    import matplotlib; matplotlib.use("Agg"); import matplotlib.pyplot as plt
+    lib = load_lib(); model = build_model(lib); data = mujoco.MjData(model)
+    renderer = mujoco.Renderer(model, height=900, width=900)
+    c = mujoco.MjvCamera()
+    c.azimuth, c.elevation, c.distance = (cam or (185, -8, 0.72))
+    c.lookat = np.array([0.34, 0.0, 1.02])
+    imgs = []
+    for label, vec in cells:
+        apply_pose(model, data, both_hands(lib, vec))
+        renderer.update_scene(data, camera=c)
+        imgs.append((label, renderer.render().copy()))
+    n = len(imgs); rows = (n + cols - 1) // cols
+    fig, axes = plt.subplots(rows, cols, figsize=(3.1 * cols, 3.3 * rows))
+    axes = np.array(axes).reshape(-1)
+    for ax in axes: ax.axis("off")
+    for ax, (label, im) in zip(axes, imgs):
+        ax.imshow(im); ax.set_title(label, fontsize=11); ax.axis("off")
+    fig.suptitle(title, fontsize=14)
+    fig.tight_layout(); fig.savefig(out, dpi=105, bbox_inches="tight"); print(f"[out] {out}")
+
+
+def cmd_render(args):
+    lib = load_lib()
+    cells = [(name, resolve_vec(lib, name, "medium", "firm")) for name in lib["primitives"]]
+    _render_grid(cells, args.out, "Inspire hand-primitive library  (medium / firm)  |  G1 + Inspire", cols=4)
+
+
+def cmd_vary(args):
+    lib = load_lib()
+    name = args.primitive
+    cells = []
+    for size in ("large", "medium", "small"):
+        for strength in ("light", "firm", "tight"):
+            cells.append((f"{name}\n{size} / {strength}", resolve_vec(lib, name, size, strength)))
+    _render_grid(cells, args.out, f"'{name}'  -  size x strength variations the policy can trial", cols=3)
+
+
+# ------------------------------------------------------------------ live viewer
+def cmd_live(args):
+    import mujoco, mujoco.viewer
+    lib = load_lib(); model = build_model(lib); data = mujoco.MjData(model)
+
+    # sequence: name -> resolved 12-joint targets (per side). include a few variations.
+    seq = []
+    for name in lib["primitives"]:
+        seq.append((f"{name}  (medium/firm)", both_hands(lib, resolve_vec(lib, name, "medium", "firm"))))
+    for size in ("large", "medium", "small"):
+        seq.append((f"power_grasp  ({size}/firm)", both_hands(lib, resolve_vec(lib, "power_grasp", size, "firm"))))
+    for strength in ("light", "firm", "tight"):
+        seq.append((f"power_grasp  (small/{strength})", both_hands(lib, resolve_vec(lib, "power_grasp", "small", strength))))
+
+    apply_pose(model, data, seq[0][1])
+    v = mujoco.viewer.launch_passive(model, data, show_left_ui=False, show_right_ui=False)
+    v.cam.azimuth, v.cam.elevation, v.cam.distance = 188, -6, 1.15
+    v.cam.lookat = np.array([0.26, 0.0, 0.98])
+
+    # capture the finger-joint addresses we animate
+    def targets_to_arr(t):
+        arr = {}
+        for side, m in t.items():
+            for suf, ang in m.items():
+                arr[qadr(model, side + suf)] = ang
+        return arr
+
+    print("\n=== Inspire hand-primitive library — live demo ===")
+    print("Both hands cycle through the library. Close the viewer window to stop.\n")
+    HOLD, MOVE, FPS = 1.1, 0.7, 60.0
+    i = 0
+    cur = targets_to_arr(seq[0][1])
+    while v.is_running():
+        nxt_label, nxt_t = seq[(i + 1) % len(seq)]
+        nxt = targets_to_arr(nxt_t)
+        print(f"  -> {nxt_label}")
+        steps = int(MOVE * FPS)
+        for s in range(steps + 1):
+            if not v.is_running(): break
+            a = s / steps
+            for adr in nxt:
+                start = cur.get(adr, data.qpos[adr])
+                data.qpos[adr] = (1 - a) * start + a * nxt[adr]
+            mujoco.mj_forward(model, data); v.sync(); time.sleep(1.0 / FPS)
+        cur = dict(nxt)
+        t0 = time.time()
+        while time.time() - t0 < HOLD and v.is_running():
+            v.sync(); time.sleep(1.0 / FPS)
+        i = (i + 1) % len(seq)
+    print("[live] viewer closed.")
+
+
+if __name__ == "__main__":
+    ap = argparse.ArgumentParser()
+    sub = ap.add_subparsers(dest="cmd", required=True)
+    r = sub.add_parser("render"); r.add_argument("--out", default=os.path.join(HERE, "primitives_montage.png")); r.set_defaults(fn=cmd_render)
+    va = sub.add_parser("vary"); va.add_argument("--primitive", default="power_grasp"); va.add_argument("--out", default=os.path.join(HERE, "primitives_variations.png")); va.set_defaults(fn=cmd_vary)
+    lv = sub.add_parser("live"); lv.set_defaults(fn=cmd_live)
+    args = ap.parse_args(); args.fn(args)
