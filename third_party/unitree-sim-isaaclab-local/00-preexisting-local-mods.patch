diff --git a/action_provider/action_provider_policy.py b/action_provider/action_provider_policy.py
new file mode 100644
index 0000000..08d4174
--- /dev/null
+++ b/action_provider/action_provider_policy.py
@@ -0,0 +1,166 @@
+# Copyright (c) 2025, Unitree Robotics Co., Ltd. All Rights Reserved.
+# License: Apache License, Version 2.0
+"""
+ACT policy action provider for Isaac Sim.
+
+Connects to the inference_server.py process (running in the `lerobot` env, Python 3.12)
+via ZMQ REQ/REP on tcp://127.0.0.1:55765. Start the server before launching Isaac Sim:
+
+    conda activate lerobot
+    python "$LEROBOT_TOOLS/inference_server.py" \\
+        --model_path .../checkpoints/last/pretrained_model
+
+Usage — pass to sim_main.py:
+    --action_source=policy
+    --enable_inspire_dds
+"""
+
+from __future__ import annotations
+
+import logging
+from typing import Optional
+
+import cv2
+import msgpack_numpy as mpn
+import numpy as np
+import torch
+import zmq
+
+from action_provider.action_base import ActionProvider
+
+logger = logging.getLogger(__name__)
+
+INFERENCE_ENDPOINT = "tcp://127.0.0.1:55765"
+
+# Arm joint names in training dataset order
+_ARM_JOINT_NAMES = [
+    "left_shoulder_pitch_joint",  "left_shoulder_roll_joint",
+    "left_shoulder_yaw_joint",    "left_elbow_joint",
+    "left_wrist_roll_joint",      "left_wrist_pitch_joint",
+    "left_wrist_yaw_joint",
+    "right_shoulder_pitch_joint", "right_shoulder_roll_joint",
+    "right_shoulder_yaw_joint",   "right_elbow_joint",
+    "right_wrist_roll_joint",     "right_wrist_pitch_joint",
+    "right_wrist_yaw_joint",
+]
+
+# Inspire joint names in sim order: right(6) then left(6)
+_INSPIRE_JOINT_NAMES = [
+    "R_pinky_proximal_joint", "R_ring_proximal_joint", "R_middle_proximal_joint",
+    "R_index_proximal_joint", "R_thumb_proximal_pitch_joint", "R_thumb_proximal_yaw_joint",
+    "L_pinky_proximal_joint", "L_ring_proximal_joint", "L_middle_proximal_joint",
+    "L_index_proximal_joint", "L_thumb_proximal_pitch_joint", "L_thumb_proximal_yaw_joint",
+]
+
+_TRAIN_H, _TRAIN_W = 720, 640
+
+
+class ACTPolicyActionProvider(ActionProvider):
+    """Runs the trained ACT policy by talking to the inference_server.py subprocess."""
+
+    def __init__(self, env, args_cli):
+        super().__init__("ACTPolicyActionProvider")
+        self.env = env
+        self._device = torch.device(env.device if hasattr(env, "device") else "cuda")
+
+        self._connect_zmq()
+        self._setup_joint_mapping()
+
+    # ------------------------------------------------------------------
+    # Setup
+    # ------------------------------------------------------------------
+
+    def _connect_zmq(self):
+        self._zmq_ctx = zmq.Context()
+        self._sock = self._zmq_ctx.socket(zmq.REQ)
+        self._sock.connect(INFERENCE_ENDPOINT)
+        # No timeout — block until the inference server responds.
+        # This means the sim will freeze on the first step if the server isn't up yet,
+        # but it will NOT crash. Start inference_server.py first.
+        logger.info("Connected to inference server at %s", INFERENCE_ENDPOINT)
+        print(f"[ACTPolicyActionProvider] Waiting for inference server at {INFERENCE_ENDPOINT} ...")
+
+    def _reconnect_zmq(self):
+        """Recreate the REQ socket after any error (REQ is stateful and breaks on failure)."""
+        try:
+            self._sock.close(linger=0)
+        except Exception:
+            pass
+        self._sock = self._zmq_ctx.socket(zmq.REQ)
+        self._sock.connect(INFERENCE_ENDPOINT)
+
+    def _setup_joint_mapping(self):
+        joint_names = list(self.env.scene["robot"].data.joint_names)
+
+        self._arm_idx = torch.tensor(
+            [joint_names.index(n) for n in _ARM_JOINT_NAMES],
+            dtype=torch.long, device=self._device,
+        )
+        self._inspire_idx = torch.tensor(
+            [joint_names.index(n) for n in _INSPIRE_JOINT_NAMES],
+            dtype=torch.long, device=self._device,
+        )
+        self._n_joints = len(joint_names)
+        logger.info("Joint mapping: %d arm, %d inspire, %d total",
+                    len(_ARM_JOINT_NAMES), len(_INSPIRE_JOINT_NAMES), self._n_joints)
+
+    # ------------------------------------------------------------------
+    # Observation helpers
+    # ------------------------------------------------------------------
+
+    def _get_state(self, joint_pos: torch.Tensor) -> np.ndarray:
+        """Build 26-dim state: [left_arm(7), right_arm(7), left_ee(6), right_ee(6)]."""
+        arm  = joint_pos[self._arm_idx]      # (14,)
+        insp = joint_pos[self._inspire_idx]  # (12,): [R(6), L(6)]
+        left_ee  = insp[6:12]
+        right_ee = insp[0:6]
+        return torch.cat([arm, left_ee, right_ee]).cpu().float().numpy()  # (26,)
+
+    def _get_image(self, cam_name: str) -> np.ndarray:
+        """Return (H, W, 3) uint8 numpy from sim camera, resized to training dims."""
+        try:
+            img = self.env.scene[cam_name].data.output["rgb"][0]
+            img_np = img.cpu().numpy() if img.is_cuda else img.numpy()
+            if img_np.dtype != np.uint8:
+                img_np = (img_np * 255).clip(0, 255).astype(np.uint8)
+            if img_np.shape[:2] != (_TRAIN_H, _TRAIN_W):
+                img_np = cv2.resize(img_np, (_TRAIN_W, _TRAIN_H))
+            return img_np
+        except Exception as e:
+            logger.warning("Camera %s unavailable: %s — using zeros", cam_name, e)
+            return np.zeros((_TRAIN_H, _TRAIN_W, 3), dtype=np.uint8)
+
+    # ------------------------------------------------------------------
+    # Main tick
+    # ------------------------------------------------------------------
+
+    def get_action(self, env) -> Optional[torch.Tensor]:
+        joint_pos = env.scene["robot"].data.joint_pos[0].to(self._device)
+
+        req = {
+            "state":   self._get_state(joint_pos),
+            "color_0": self._get_image("front_camera"),
+            "color_1": self._get_image("left_wrist_camera"),
+        }
+
+        try:
+            self._sock.send(mpn.packb(req))
+            raw = self._sock.recv()
+        except zmq.ZMQError as e:
+            logger.warning("ZMQ error (%s) — reconnecting to inference server", e)
+            self._reconnect_zmq()
+            return None  # controller falls back to last action this tick; recovers next tick
+
+        resp = mpn.unpackb(raw)
+        if "error" in resp:
+            logger.error("Inference server error: %s", resp["error"])
+            return None
+
+        action = torch.tensor(resp["action"], dtype=torch.float32, device=self._device)  # (26,)
+
+        full = joint_pos.clone()
+        full[self._arm_idx]           = action[:14]
+        full[self._inspire_idx[0:6]]  = action[20:26]  # right EE
+        full[self._inspire_idx[6:12]] = action[14:20]  # left EE
+
+        return full.unsqueeze(0)  # (1, N_joints)
