+    def _gains_acceptable(self, mc) -> bool:
+        """True when the message carries 29 strictly positive kp AND kd.
+
+        Evaluated per tick, because it gates POSITION tracking too: a message
+        whose gains are rejected (damp: kp=0) must not have its q obeyed."""
+        kp = mc.get('kp') or []
+        kd = mc.get('kd') or []
+        return (len(kp) >= 29 and len(kd) >= 29
+                and min(kp[:29]) > 0.0 and min(kd[:29]) > 0.0)
+
+    def _apply_message_gains(self, cmd_data):
+        """Write the lowcmd's per-joint kp/kd into the PhysX drives.
+
+        The external controller's PD law is tau = kp*(q_des-q) + kd*(0-dq);
+        the asset's fixed gains are a different plant than the one it was
+        tuned on (shoulders 100/2 vs a commanded ~14.25/0.907). Gains are
+        constants per joint, so one write suffices -- re-applied on a slow
+        cadence so an env reset cannot silently restore the asset gains.
+        Callers gate on _gains_acceptable; the check here is defense in
+        depth -- non-positive gains must never strip the drives.
+        """
+        self._gain_tick += 1
+        if self._gains_applied and (self._gain_tick % 500) != 0:
+            return
+        mc = cmd_data.get('motor_cmd') or {}
+        kp = mc.get('kp') or []
+        kd = mc.get('kd') or []
+        if not self._gains_acceptable(mc):
+            return
+        robot = self.env.scene["robot"]
+        stiffness = torch.tensor([kp[:29]], dtype=torch.float32, device=self.env.device)
+        damping = torch.tensor([kd[:29]], dtype=torch.float32, device=self.env.device)
+        robot.write_joint_stiffness_to_sim(stiffness, joint_ids=self._fb_target_indices)
+        robot.write_joint_damping_to_sim(damping, joint_ids=self._fb_target_indices)
+        if not self._gains_applied:
+            print(f"[{self.name}] SONIC message gains -> PhysX drives (kp hip {kp[0]:.1f}, knee {kp[3]:.1f}, "
+                  f"ankle {kp[4]:.1f}, waist_yaw {kp[12]:.1f}, shoulder {kp[15]:.1f}, wrist_pitch {kp[20]:.1f})", flush=True)
+        self._gains_applied = True
+
