@@ -452,6 +452,35 @@ def main():
         print("========= start controller =========")
         controller.start()
         print("========= start controller success =========")
+
+        # --- physicalagent sidecar (added) --------------------------
+        # Answers pose/contact/camera questions on ZMQ 5570 for the safety
+        # layer and its probes. The ZMQ thread owns the socket end to end and
+        # NEVER touches the env: omni.physx.tensors is not thread-safe, and a
+        # concurrent tensor read raced the physics step into a device-side
+        # CUDA assert that killed the GPU context (2026-08-07, first get-up
+        # A/B attempt). The main loop below feeds it plain-python snapshots
+        # instead. A missing checkout costs the sidecar only.
+        _sidecar_box = {}
+        if not args_cli.replay_data:
+            def _sidecar_loop():
+                try:
+                    import sys as _sys
+                    _pa = __import__("os").environ.get("PA_ROOT", "")  # repo root
+                    if _pa and _pa not in _sys.path: _sys.path.append(_pa)
+                    from simbridge.isaac_sidecar import IsaacSidecar
+                    _sc = IsaacSidecar()
+                    _sidecar_box["sc"] = _sc
+                    print("[sidecar] serving on 5570 (snapshot-fed)", flush=True)
+                except Exception as _exc:
+                    print(f"[sidecar] unavailable: {_exc!r}", flush=True)
+                    return
+                while True:
+                    _sc.poll()
+                    time.sleep(0.005)
+            import threading as _threading
+            _threading.Thread(target=_sidecar_loop,
+                              daemon=True, name="isaac_sidecar").start()
         
         # main loop - execute in main thread to support rendering
         last_stats_time = time.time()
@@ -468,6 +497,20 @@ def main():
