+        # SONIC_WB_TARGET_RTF pins the real-time factor by sleeping when the
+        # loop runs FASTER than the target, exactly as the SONIC MuJoCo
+        # reference pins 1.0 with an absolute-deadline limiter.
+        #
+        # Why pin rather than go as fast as possible: the external controller
+        # is paced on the wall clock, so it must be slowed by 1/RTF to stay
+        # in step (tools/sonic_timescale.so). A DRIFTING RTF makes that a
+        # coin flip -- measured 2026-08-18, four runs separating perfectly on
+        # whether the scale matched: RTF 0.179 w/ scale 1.0 collapse, 0.296
+        # w/ 2.5 collapse, 0.291 w/ 3.4 STANDS, 0.205 w/ 3.4 collapse. Set
+        # the target BELOW the worst achievable rate and the pairing becomes
+        # deterministic. 0 disables (vendor behaviour).
+        try:
+            self._rtf_target = float(os.environ.get("SONIC_WB_TARGET_RTF", "0"))
+        except ValueError:
+            self._rtf_target = 0.0
+        self._rtf_deadline = None
+        self._rtf_late = 0
